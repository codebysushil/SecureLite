{
    "name": "sushilk/securelite",
    "description": "A lightweight SQLCipher-backed SQLite3 database library for PHP.",
    "keywords": [
        "securelite",
        "sqlite",
        "sqlcipher",
        "cipher",
        "encryption",
        "encrypted"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-sqlite3": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "SecureLite\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Sushil Kumar",
            "email": "sushilkumbhar77@gmail.com"
        }
    ],
    "scripts": {
        "tests": [
            "@php examples/index.php",
            "cat database.sqlite"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
